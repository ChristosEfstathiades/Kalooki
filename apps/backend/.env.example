# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Chat links (hosts a chat message may link to, comma separated).
# Subdomains of a listed host are allowed. Defaults to the APP_URL host
# plus localhost outside production.
#--------------------------------------------------------------------
# CHAT_LINK_ALLOWED_HOSTS=kalooki.example,cdn.kalooki.example

#--------------------------------------------------------------------
# Database (SQLite by default; use Postgres in production)
#--------------------------------------------------------------------
# DB_CONNECTION=pg
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=kalooki
# PG_PASSWORD=
# PG_DB_NAME=kalooki

#--------------------------------------------------------------------
# CORS: origins allowed to call this API from a browser, comma
# separated. Read in production only; outside production every origin
# is reflected so the local frontend and admin ports just work.
#
# In production this must list the player site AND the admin site, or
# their requests fail preflight. Leave it unset only when the frontend
# is served from this same hostname.
#--------------------------------------------------------------------
# CORS_ORIGIN=https://kalooki.example,https://admin.kalooki.example

#--------------------------------------------------------------------
# Where the player-facing site lives. Email verification links point
# here, not at the API. Defaults to APP_URL, which is correct only for
# a same-origin deployment.
#--------------------------------------------------------------------
# FRONTEND_URL=https://kalooki.example

#--------------------------------------------------------------------
# Mail (Resend). Required in production: without RESEND_API_KEY the
# verification email cannot be sent and no new account can ever sign
# in. Outside production the link is written to the log instead, so
# local signups need no provider.
#
# MAIL_FROM_ADDRESS must be on a domain verified with Resend.
#--------------------------------------------------------------------
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS=no-reply@kalooki.example
# MAIL_FROM_NAME=Kalooki Online