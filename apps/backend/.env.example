# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Chat links (hosts a chat message may link to, comma separated).
# Subdomains of a listed host are allowed. Defaults to the APP_URL host
# plus localhost outside production.
#--------------------------------------------------------------------
# CHAT_LINK_ALLOWED_HOSTS=kalooki.example,cdn.kalooki.example

#--------------------------------------------------------------------
# Database (SQLite by default; use Postgres in production)
#--------------------------------------------------------------------
# DB_CONNECTION=pg
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=kalooki
# PG_PASSWORD=
# PG_DB_NAME=kalooki

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000